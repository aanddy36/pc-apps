---
import Button from "../components/Button.astro";
import { NewNavbar } from "../components/NewNavbar";
import Picker from "../components/Picker.astro";
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import logoPcApps from "../assets/logo.png";
import { getCollection } from "astro:content";
import ServiceDropdown from "../components/ServiceDropdown.astro";
import Footer from "../components/sections/Footer.astro";
import "../index.css";
import { WhatsappBtn } from "../components/WhatsappBtn";

const lang = getLangFromUrl(Astro.url);
let activeLink = "";
if (lang === "en") {
  activeLink = Astro.request.url.split("/")[3];
} else {
  activeLink = Astro.request.url.split("/")[4];
}

const allServices = await getCollection("theServices", ({ id }) => {
  return id.startsWith(lang + "/");
});

const t = useTranslations(lang);
const link = Astro.request.url;

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/pc-logo.png" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={`PC APPS | ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.request.url} />
    <meta property="og:image" content="https://pcappsint.com/pc-logo.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="pcappsint.com" />
    <meta property="twitter:url" content="https://pcappsint.com/" />
    <meta name="twitter:title" content={`PC APPS | ${title}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://pcappsint.com/pc-logo.png" />
    <title>{`PC APPS | ${title}`}</title>
  </head>
  <body class="bg-bg flex flex-col min-h-screen">
    <NewNavbar link={link} allServices={allServices} client:load>
      <a href={`${lang === "en" ? "/" : "/es"}`}>
        <Image src={logoPcApps} alt={t("nav.altLogo")} width="140" />
      </a>
      <ul class="hidden laptop:flex gap-7 items-center">
        <a
          href={`${lang === "en" ? "/" : "/es"}`}
          class={`transition-all duration-200 hover:text-blue
              hover:border-b-2 hover:border-b-blue border-2 border-transparent 
              ${!activeLink && " text-blue opacity-100 border-b-2 border-b-blue font-bold"}`}
        >
          <li>{t("nav.home")}</li>
        </a>
        <a
          href={`${lang === "en" ? "" : "/es"}/about`}
          class={`transition-all duration-200 hover:text-blue
            hover:border-b-2 hover:border-b-blue border-2 border-transparent 
            ${activeLink === "about" && " text-blue opacity-100 border-b-2 border-b-blue font-bold"}`}
        >
          <li>{t("nav.whoweare")}</li>
        </a>
        <ServiceDropdown />
      </ul>
      <ul class="hidden laptop:flex items-center gap-2">
        <li>
          <Button path={`${lang === "en" ? "" : "/es"}/contact`}>
            {t("nav.contactBtn")}
          </Button>
        </li>
        <li>
          <Picker />
        </li>
      </ul>
    </NewNavbar>
    <div class="grow">
      <slot />
    </div>
    <WhatsappBtn client:load/>
    <Footer />
  </body>
</html>
