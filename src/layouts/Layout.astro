---
import Button from "../components/Button.astro";
import Navbar from "../components/Navbar.astro";
import { NewNavbar } from "../components/NewNavbar";
import Picker from "../components/Picker.astro";
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import logoPcApps from "../assets/logo.png";

const theLang = getLangFromUrl(Astro.url);
const t = useTranslations(theLang);
const activeLink = Astro.request.url.split("/")[4];
const link = Astro.request.url;

const lang = getLangFromUrl(Astro.url);

interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
const URL = import.meta.env.PUBLIC_URL;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/PC_ICON.svg" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={`PC APPS | ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${URL}/${path}`} />
    <meta property="og:image" content="./logo.png" />
    <title>{`PC APPS | ${title}`}</title>
  </head>
  <body class="bg-bg flex flex-col min-h-screen">
    <!-- <Navbar /> -->
    <NewNavbar link={link} client:load>
      <a href={`/${theLang}`}>
        <Image src={logoPcApps} alt={t("nav.altLogo")} width="140" />
      </a>
      <ul class="hidden laptop:flex gap-7 items-center">
        <a
          href={`/${theLang}`}
          class={`transition-all duration-200 hover:text-blue
              hover:border-b-2 hover:border-b-blue border-2 border-transparent 
              ${!activeLink && " text-blue opacity-100 border-b-2 border-b-blue font-bold"}`}
        >
          <li>{t("nav.home")}</li>
        </a>
        <a
          href={`/${theLang}/about`}
          class={`transition-all duration-200 hover:text-blue
            hover:border-b-2 hover:border-b-blue border-2 border-transparent 
            ${activeLink === "about" && " text-blue opacity-100 border-b-2 border-b-blue font-bold"}`}
        >
          <li>{t("nav.whoweare")}</li>
        </a>
        <a
          href="/en"
          class={`transition-all duration-200 hover:text-blue
            hover:border-b-2 hover:border-b-blue border-2 border-transparent 
            ${activeLink === "services" && " text-blue opacity-100 border-b-2 border-b-blue font-bold"}`}
        >
          <li>{t("nav.services")}</li>
        </a>
      </ul>
      <ul class="hidden laptop:flex items-center gap-2">
        <li>
          <Button path="/en">{t("nav.contactBtn")}</Button>
        </li>
        <li>
          <Picker />
        </li>
      </ul>
    </NewNavbar>
    <div class="grow border-2">
      <slot />
    </div>
  </body>
</html>
