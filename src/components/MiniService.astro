---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Image } from "astro:assets";
import payment from "../assets/payment.png";
import pc from "../assets/pc.png";
import app from "../assets/app.png";
import energy from "../assets/energy.png";
import Button from "./Button.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  position: 1 | 2 | 3 | 4;
  path: string;
}

const { position, path } = Astro.props;
const imagesArray = [pc, app, payment,energy];
---

<div class="flex flex-col items-center gap-5">
  <Image
    src={imagesArray[position - 1]}
    alt={t(`home.serviceAlt${position}`)}
    class="w-[80px]"
  />
  <h5 class="font-semibold text-2xl text-center">{t(`home.serviceTitle${position}`)}</h5>
  <p class="font-light text-sm text-center">{t(`home.serviceDescr${position}`)}</p>
  <Button path={`${lang === "en" ? "" : "/es"}/our-services/${path}`}>{t("home.serviceBtn")}</Button>
</div>
