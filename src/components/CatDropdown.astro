---
import { getLangFromUrl } from "../i18n/utils";
import { getCollection } from "astro:content";

const theLang = getLangFromUrl(Astro.url);
const allServices = await getCollection("theServices", ({ id }) => {
  return id.startsWith(theLang + "/");
});

interface Props {
  category: string;
}

const { category } = Astro.props;
---

<div class="flex flex-col gap-2 p-4 border-t rounded-lg">
  <h5 class="font-semibold">{category}</h5>
  <div class="flex flex-col gap-2 pl-4 w-full">
    {
      allServices
        .filter((cons) => cons.data.group === category)
        .map((service) => {
          return (
            <a
              href={`/${theLang}/our-services/${service.slug.split("/")[1]}`}
              class=" transition-all duration-200 hover:px-4 hover:text-blue"
            >
              {service.data.title}
            </a>
          );
        })
    }
  </div>
</div>
