---
import Button from "./Button.astro";
import Picker from "./Picker.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const theLang = getLangFromUrl(Astro.url);
const t = useTranslations(theLang);
---

<nav
  class="border h-[80px] w-full flex py-5 px-10 items-center justify-between"
>
  <a href={`/${theLang}/`} class="border">
    <img src="./logo.png" width="121" height="70" alt={t("nav.altLogo")} />
  </a>
  <ul class=" hidden laptop:flex gap-7 items-center">
    <a
      href={`/${theLang}/`}
      class="transition-all duration-200 hover:text-blue opacity-70 hover:opacity-100
          hover:border-b-2 hover:border-b-blue border-2 border-transparent"
    >
      <li>{t("nav.home")}</li>
    </a>
    <a
      href="/en/"
      class="transition-all duration-200 hover:text-blue opacity-70 hover:opacity-100
          hover:border-b-2 hover:border-b-blue border-2 border-transparent"
    >
      <li>{t("nav.whoweare")}</li>
    </a>
    <a
      href="/en"
      class="transition-all duration-200 hover:text-blue opacity-70 hover:opacity-100
          hover:border-b-2 hover:border-b-blue border-2 border-transparent"
    >
      <li>{t("nav.services")}</li>
    </a>
  </ul>
  <ul class=" hidden laptop:flex items-center gap-2">
    <li>
      <Button path="/en">{t("nav.contactBtn")}</Button>
    </li>
    <li>
      <Picker />
    </li>
  </ul>
  <button class=" laptop:hidden">
    <img src="./public/toggle-bars.png" />
  </button>
</nav>
