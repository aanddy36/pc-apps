---
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Button from "../components/Button.astro";
import imagen from "../assets/404-img.png";
import { Image } from "astro:assets";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title="404 Page"
  description={`It seems like you've taken a wrong turn. Go back the way you came, and we'll have a chat with Ezreal about his maps...`}
>
  <h1
    class="w-full py-5 laptop:py-8 bg-blue text-[22px] tablet:text-[26px] laptop:text-3xl
font-extrabold text-center text-white"
  >
    {t("error.404")}
  </h1>
  <div
    class="px-12 py-12 full:py-6 flex flex-col full:flex-row w-full justify-center gap-20 full:gap-6 items-center h-full"
  >
    <div
      class="flex flex-col gap-10 h-full justify-center items-center full:items-start"
    >
      <h1 class="text-6xl font-bold">{t("error.oops")}</h1>
      <span class="text-3xl opacity-70">{t("error.text")}</span>
      <Button path={`${lang === "en" ? "" : "/es"}/`}>{t("error.btn")}</Button>
    </div>
    <Image src={imagen} alt={"404"} width={"400"} />
  </div>
</Layout>
