---
import Layout from "../../layouts/Layout.astro";
import { CarouselSection } from "../../components/CarouselSection.tsx";
import { getLangFromUrl,useTranslations } from "../../i18n/utils";
import MiniService from "../../components/MiniService.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const servicePaths = [
  "personal-tax",
  "corporate-tax",
  "web-design",
  "mobile-app",
];
---

<Layout
  title="Home"
  description="Home page, where you can find all the services we provide and know who we are"
  path="en/"
>
  <CarouselSection client:load lang={lang} />
  <section class="pb-16 px-5 laptop:px-16 pt-14 tablet:pt-24 flex flex-col gap-16">
    <div class="w-full flex flex-col items-center gap-2">
      <h5 class="text-blue font-medium tablet:text-lg">{t("home.serviceTitle")}</h5>
      <h3 class="text-black font-semibold text-center text-2xl tablet:text-4xl">
        {t("home.serviceSubtitle")}
      </h3>
    </div>
    <div class="grid grid-cols-1 tablet:grid-cols-2 laptop:grid-cols-3 full:grid-cols-4 gap-16">
      {
        servicePaths.map((ser, i) => (
          <MiniService position={(i + 1) as 1 | 2 | 3 | 4} path={ser} />
        ))
      }
    </div>
  </section>
</Layout>
