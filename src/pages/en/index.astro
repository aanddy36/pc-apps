---
import Layout from "../../layouts/Layout.astro";
import { CarouselSection } from "../../components/sections/CarouselSection.tsx";
import { getLangFromUrl } from "../../i18n/utils";
import HomeServices from "../../components/sections/HomeServices.astro";
import HomeAbout from "../../components/sections/HomeAbout.astro";

const lang = getLangFromUrl(Astro.url);

---

<Layout
  title="Home"
  description="Home page, where you can find all the services we provide and know who we are"
  path="en/"
>
  <CarouselSection client:load lang={lang} />
  <HomeServices />
  <HomeAbout />
</Layout>
