---
import Layout from "../../layouts/Layout.astro";
import { CarouselSection } from "../../components/sections/CarouselSection.tsx";
import { getLangFromUrl } from "../../i18n/utils";
import HomeServices from "../../components/sections/HomeServices.astro";
import HomeAbout from "../../components/sections/HomeAbout.astro";

const lang = getLangFromUrl(Astro.url);
---

<Layout
  title="Inicio"
  description={`PC APPS es una compañia que provee servicios de declaración de impuestos en 
  USA, diseño web y móvil, y consultorías en diversas áreas. ¡Descubre todos los servicios 
  que tenemos disponibles!`}
>
  <CarouselSection client:load lang={lang} />
  <HomeServices />
  <HomeAbout />
</Layout>
