---
import Layout from "../../layouts/Layout.astro";
import { CarouselSection } from "../../components/sections/CarouselSection.tsx";
import { getLangFromUrl } from "../../i18n/utils";
import HomeServices from "../../components/sections/HomeServices.astro";
import HomeAbout from "../../components/sections/HomeAbout.astro";

const lang = getLangFromUrl(Astro.url);


---

<Layout
  title="Inicio"
  description="Página de inicio, donde puedes conocer los servicios que brindamos y saber quiénes somos"
  path="es/"
>
  <CarouselSection client:load lang={lang} />
  <HomeServices />
  <HomeAbout />
</Layout>
