---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import { SmallForm } from "../../../components/SmallForm";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export const getStaticPaths = async () => {
  const allServices = await getCollection("theServices", ({ id }) => {
    return id.startsWith("es/");
  });

  const paths = allServices.map((page) => {
    const [lang, ...slug] = page.slug.split("/");
    return { params: { lang, slug: slug.join("/") || undefined }, props: page };
  });
  return paths;
};
const theLang = getLangFromUrl(Astro.url);
const t = useTranslations(theLang as "en" | "es");
const theService = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/imagess/*.{jpeg,jpg,png,gif}"
);
if (!images[theService.data.image])
  throw new Error(
    `"${theService.data.image}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif}"`
  );
---

<Layout
  title={theService.data.title}
  description={theService.data.description}
>
  <h1
    class="w-full py-5 laptop:py-8 bg-blue text-[22px] tablet:text-[26px] laptop:text-3xl
    font-extrabold text-center text-white"
  >
    {theService.data.title}
  </h1>
  <main class="flex flex-col full:flex-row w-full">
    <section
      class="grow flex flex-col px-4 pt-10 pb-16 laptop:px-16 gap-10 items-start"
    >
      <div class="w-full flex flex-col gap-3">
        <h2 class="text-3xl laptop:text-4xl font-bold">
          {theService.data.articleTitle1}
        </h2>
        <p class="text-left">{theService.data.articleText1}</p>
      </div>
      <Image
        src={images[theService.data.image]()}
        alt={"Service Image"}
        class={`w-full h-[250px] laptop:h-[300px] tablet:h-[400px] rounded-lg`}
      />
      {
        theService.data.articleTitle2 && (
          <div class="flex flex-col gap-3 w-full">
            <h3 class="text-3xl font-semibold">
              {theService.data.articleTitle2}
            </h3>
            <p class="text-left">{theService.data.articleText2}</p>
            {theService.data.articleText3 && (
              <p class="text-left">{theService.data.articleText3}</p>
            )}
          </div>
        )
      }
      <p>{theService.data.articleListTitle}</p>
      <ol class="flex flex-col items-start gap-1">
        {
          theService.data.articleItems.map((item) => {
            return <li class=" list-disc list-inside">{item}</li>;
          })
        }
      </ol>
    </section>
    <section
      class="bg-sectionBg w-full laptop:min-w-[500px] flex flex-col items-center gap-8 px-4
      laptop:px-8 py-12"
    >
      <div class="flex flex-col items-center gap-3">
        <h3 class="text-3xl font-semibold text-center">
          {t("nav.contactBtn")}
        </h3>
        <p class="text-center">{t("contact.formText")}</p>
      </div>
      <SmallForm lang={theLang} client:only />
    </section>
  </main>
</Layout>
